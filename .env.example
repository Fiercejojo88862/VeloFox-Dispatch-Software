# VeloFox Dispatch Software — environment template
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.

# HTTP port for the Express server (defaults to 3000 when unset).
PORT=3000

# Required to create new dispatcher accounts. Use a long, random value and
# provide it only to authorized staff. Do not commit the real code.
DISPATCHER_INVITE_CODE=replace-with-a-long-random-code

# Login session lifetime in hours (defaults to 12).
SESSION_TTL_HOURS=12

# Chauffeur portal session lifetime in hours (defaults to 12).
# DRIVER_SESSION_TTL_HOURS=12

# Optional fallback code for chauffeurs who have not been issued a personal
# access code from drivers-admin.html. Admin-issued codes take precedence.
# DRIVER_FALLBACK_ACCESS_CODE=change-me

# Public base URL used to construct local password reset links.
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection string used by the backend.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Required: accounts, sessions, bookings, reviews, feedback, and telemetry are
# persisted here. The schema in schema.sql is applied automatically on startup.
#
# Local Docker example (matches the defaults above):
#   docker run -d --name velofox-postgres \
#     -e POSTGRES_USER=user -e POSTGRES_PASSWORD=password \
#     -e POSTGRES_DB=velofox -p 5432:5432 postgres:16-alpine
#
# On Vercel use a *pooled* connection string from Neon (-pooler host), Supabase
# (port 6543), or Vercel Postgres, then add it to the project:
#   vercel env add DATABASE_URL production
DATABASE_URL=postgres://user:password@localhost:5432/velofox

# Optional: direct (unpooled) connection string. `neon env pull` writes both.
# The schema bootstrap takes a session-level advisory lock, which a
# transaction-mode pooler cannot guarantee, so it prefers this URL when set.
# Locally it can be omitted and DATABASE_URL is used for everything.
# DATABASE_URL_UNPOOLED=postgres://user:password@localhost:5432/velofox

# Optional: cap the PostgreSQL pool size. Defaults to 1 when VERCEL is set
# (serverless) and 10 for local/self-hosted runs.
# PG_POOL_MAX=10

# Optional: driver job-alert emails. Resend is the mail app used here. Driver
# emails are set on the driver roster (drivers-admin.html); when a driver is
# assigned a job, they get a "New job dispatched" email at this address.
# RESEND_API_KEY=replace-with-your-resend-api-key
# MAIL_FROM=noreply@yourdomain.com

# Optional: SMS driver alerts via Unlimited Messaging — the one SMS service
# used here. Free plan is permanent, needs no credit card, and sends from
# your own Android phone on its carrier plan (the phone must stay online and
# charged). Setup: sign up at unlimitedmessaging.app, install the Android
# app, link your phone, then add the UM_API_KEY below (the Free plan adds a
# small "Sent with UnlimitedMessaging.app" footer to messages).
# UM_API_KEY=um_live_replace-with-your-key
